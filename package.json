{
  "name": "dsh-desktop",
  "version": "0.1.1-alpha.3",
  "description": "DeepSeek Harness 桌面客户端（Electron 主进程内嵌 Cordis Host，零端口 IPC 载波，官方 Web UI 复用主面）",
  "main": "dist/desktop-shell/main.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-web.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win --publish never && node scripts/make-sums.cjs",
    "icons": "node scripts/make-icons.cjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "jimp": "^0.22.12",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-group": "1.0.2",
    "@deepseek-ai/dsh": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-atomic-write": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-credentials": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-launch-environment": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-app-boot": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-authorization": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-bash-local": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-code-runtime": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-compaction": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-fs": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-hook-protocol": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-jobs": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-output-retention": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-sandbox": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-session-query": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-session-telemetry": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-session-title-llm": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-shell": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-spill": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-util-time": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-web-app": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-web-frontend": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-workflow": "0.1.2-alpha.4",
    "chokidar": "^4.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
