# 依赖与构建产物
node_modules/
dist/
out/
*.tsbuildinfo
.pnpm-store/
.tmp/
.runtime/

# 打包产物与缓存（M4-a1 electron-builder）
release/
.electron-builder-cache/
# 本地预下载的 electron-builder 工具集（icons 转换工具，绕开沙箱/网络受限环境）
.tools/

# 官网站点构建产物与缓存（VitePress，源在 website/）
website/.vitepress/dist/
website/.vitepress/cache/
website/.vitepress/.temp/

# 环境与密钥
.env
.env.*
!.env.example

# 本地数据（$DSH_HOME 共享目录通常位于用户目录，此处仅为仓库内兜底）
.dsh/

# 日志
*.log
npm-debug.log*

# IDE
.idea/
.vscode/
# .trae：IDE 注入的规则必须入库（.trae/rules 是规则唯一来源），其余内容照旧忽略
.trae/*
!.trae/rules/
!.trae/rules/**
*.swp

# 图标源图（tray/app 图标由 scripts/process-icon.cjs 从项目根 lansi.jpg 生成，源感不入库）
/lansi.jpg